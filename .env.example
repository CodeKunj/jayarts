# ====================================================================
# JayArt Fine Art Gallery — Environment Configuration (.env)
# ====================================================================

# Application Settings
APP_NAME="JayArt"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://jayarts.ritiverse.in

# Database Configuration (cPanel MySQL / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ritivers_jayarts
DB_USER=ritivers_jayarts
DB_PASS=YourDatabasePasswordHere
DB_CHARSET=utf8mb4

# Cache Configuration
CACHE_DRIVER=file
CACHE_TTL=900

# Session & Security
SESSION_LIFETIME=86400
