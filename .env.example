# ==============================================================================
# JayArt Fine Art Gallery E-Commerce Platform
# Environment Configuration Template (cPanel & Production Ready)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on your cPanel server (cp .env.example .env)
# 2. Fill in your cPanel MySQL database credentials, domain URL, and API keys.
# 3. NEVER commit your real .env file with secrets to public GitHub!
# ==============================================================================

# Application Environment ('production' for live hosting, 'development' for local)
APP_NAME="JayArt"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_KEY=32_char_random_cryptographic_key_here

# ------------------------------------------------------------------------------
# MySQL Database Connection (cPanel MySQL Database Wizard)
# In cPanel, database and usernames usually have a prefix like: cpaneluser_dbname
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_jayarts
DB_USER=cpaneluser_jayart
DB_PASS=YourStrongDatabasePassword123!
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# Redis-Like Custom File Cache Engine
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_PRODUCT_TTL=3600
CACHE_CATEGORY_TTL=86400
CACHE_HOMEPAGE_TTL=1800

# ------------------------------------------------------------------------------
# Payment Gateways (Razorpay & Direct UPI QR)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YourRazorpayLiveSecretKey
RAZORPAY_MODE=live

# Direct UPI (Instant zero-fee payments across India)
UPI_ID=jayartgallery@upi
UPI_PAYEE_NAME="JayArt Private Limited"

# ------------------------------------------------------------------------------
# SMTP Mail Settings (cPanel Webmail or Brevo/SendGrid/Gmail)
# ------------------------------------------------------------------------------
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=YourEmailPassword123!
SMTP_FROM_EMAIL=notifications@yourdomain.com
SMTP_FROM_NAME="JayArt Gallery Notifications"

# ------------------------------------------------------------------------------
# Webmaster, Search Console & Google Analytics 4
# ------------------------------------------------------------------------------
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GSC_VERIFICATION_TAG=google-site-verification=XXXXXXXXXX
META_PIXEL_ID=
BING_VERIFICATION_CODE=

# ------------------------------------------------------------------------------
# Store Operational Defaults
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
SUPPORT_PHONE="+91 98765 43210"
SUPPORT_EMAIL=concierge@jayartgallery.com
STORE_ADDRESS="Heritage Gallery Pavilion, Mumbai, Maharashtra 400001"
